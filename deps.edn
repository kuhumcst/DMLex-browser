{:paths   ["src"]
 :deps    {org.clojure/clojure   {:mvn/version "1.12.5"}
           org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases {;; The data build: clj -J-Xmx8g -M:build <dmlex.json> [<out-dir>]
           :build  {:main-opts ["-m" "dk.cst.dmlex-viewer.build"]}
           ;; The frontend build, driven by shadow-cljs.edn.
           :shadow {:extra-deps {thheller/shadow-cljs    {:mvn/version "3.4.11"}
                                 no.cjohansen/replicant {:mvn/version "2025.12.1"}}}}}
