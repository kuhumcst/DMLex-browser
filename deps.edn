{:paths   ["src"]
 :deps    {org.clojure/clojure   {:mvn/version "1.12.5"}
           org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases {;; The data build: clojure -J-Xmx8g -M:build <dmlex.json> [<out-dir>]
           :build  {:main-opts ["-m" "dk.cst.dmlex-viewer.build"]}
           ;; The tests: clojure -M:test
           :test   {:extra-paths ["test"]
                    :extra-deps  {io.github.cognitect-labs/test-runner
                                  {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                    :main-opts   ["-m" "cognitect.test-runner"]}
           ;; The frontend build, driven by shadow-cljs.edn.
           :shadow {:extra-paths ["test"]
                    :extra-deps  {thheller/shadow-cljs    {:mvn/version "3.4.11"}
                                  no.cjohansen/replicant {:mvn/version "2025.12.1"}}}}}
